{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "version": "2025.10",
  "sets": {
    "palette": { "sources": [{ "$ref": "palette.tokens.json" }] }
  },
  "modifiers": {
    "theme": {
      "contexts": {
        "brand": [{ "$ref": "brand.tokens.json" }]
      },
      "default": "brand"
    },
    "mode": {
      "contexts": {
        "light": [{ "$ref": "light.tokens.json" }],
        "dark": [{ "$ref": "dark.tokens.json" }]
      }
    }
  },
  "resolutionOrder": [
    { "$ref": "#/sets/palette" },
    { "$ref": "#/modifiers/theme" },
    { "$ref": "#/modifiers/mode" }
  ]
}
