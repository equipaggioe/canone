[Unit]
Description=PRODUCTO off-site backup
Requires=PRODUCTO-dump.service
After=PRODUCTO-dump.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
CacheDirectory=PRODUCTO-backup
LoadCredentialEncrypted=restic_repository:/etc/credstore.encrypted/PRODUCTO-backup/restic_repository
LoadCredentialEncrypted=restic_password:/etc/credstore.encrypted/PRODUCTO-backup/restic_password
LoadCredentialEncrypted=s3_key_id:/etc/credstore.encrypted/PRODUCTO-backup/s3_key_id
LoadCredentialEncrypted=s3_secret_key:/etc/credstore.encrypted/PRODUCTO-backup/s3_secret_key
Environment=RESTIC_REPOSITORY_FILE=%d/restic_repository
Environment=RESTIC_PASSWORD_FILE=%d/restic_password
ExecStart=/bin/sh -c 'export AWS_ACCESS_KEY_ID="$$(cat %d/s3_key_id)" AWS_SECRET_ACCESS_KEY="$$(cat %d/s3_secret_key)";   restic backup --cache-dir /var/cache/PRODUCTO-backup --host PRODUCTO /var/lib/PRODUCTO-dump /var/lib/PRODUCTO/files &&   exec restic forget --cache-dir /var/cache/PRODUCTO-backup --host PRODUCTO --prune --keep-daily 7 --keep-weekly 4 --keep-monthly 12'
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
DevicePolicy=closed
RemoveIPC=yes
UMask=0077
