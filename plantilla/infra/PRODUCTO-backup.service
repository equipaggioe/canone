[Unit]
Description=PRODUCTO backup to the receiver
Requires=PRODUCTO-dump.service
After=PRODUCTO-dump.service

[Service]
Type=oneshot
DynamicUser=yes
CacheDirectory=PRODUCTO-backup
LoadCredentialEncrypted=restic_password:/etc/credstore.encrypted/PRODUCTO-backup/restic_password
# ADR-0078: the rest-server of the receiver, through its tunnel.
Environment=RESTIC_REPOSITORY=rest:http://127.0.0.1:8001/PRODUCTO/
Environment=RESTIC_PASSWORD_FILE=%d/restic_password
Environment=RESTIC_CACHE_DIR=/var/cache/PRODUCTO-backup
# A tunnel that drops leaves restic retrying.
TimeoutStartSec=4h
# The first backup creates the repository.
ExecStart=/bin/sh -c 'restic cat config >/dev/null 2>&1 || exec restic init'
ExecStart=/usr/bin/restic backup --host PRODUCTO /var/lib/PRODUCTO-dump /var/lib/PRODUCTO/files
# Its time is the time of the last backup, which the server reads.
ExecStartPost=+/usr/bin/install -m 0644 /dev/null /var/lib/PRODUCTO/last-backup
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
DevicePolicy=closed
RemoveIPC=yes
UMask=0077
