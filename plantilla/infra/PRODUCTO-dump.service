[Unit]
Description=PRODUCTO database dump
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
StateDirectory=PRODUCTO-dump
ExecStart=/usr/bin/pg_dump --format=custom --file=/var/lib/PRODUCTO-dump/PRODUCTO.dump --dbname=PRODUCTO
ExecStart=/usr/bin/pg_dumpall --globals-only --file=/var/lib/PRODUCTO-dump/globals.sql
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
# No RemoveIPC=: it would remove the shared memory of PostgreSQL, which
# runs as the same user, and the database would refuse every connection.
UMask=0077
