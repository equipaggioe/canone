[Unit]
Description=PRODUCTO %i, in Java
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# java.md: the piece keeps no state, and only the server talks to it.
DynamicUser=yes
WorkingDirectory=/srv/PRODUCTO/current/%i
ExecStart=/usr/bin/java -jar /srv/PRODUCTO/current/%i/%i.jar
Restart=on-failure
# The JVM ends with 128 + SIGTERM when systemd stops it.
SuccessExitStatus=143
# It listens on loopback and calls no one.
IPAddressDeny=any
IPAddressAllow=localhost
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Without MemoryDenyWriteExecute=: the JIT of the JVM writes the code it runs.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
RemoveIPC=yes
UMask=0077

[Install]
WantedBy=multi-user.target
