[Unit]
Description=PRODUCTO migrations of %i
After=postgresql.service

[Service]
Type=oneshot
User=PRODUCTO
Group=PRODUCTO
WorkingDirectory=/srv/PRODUCTO/releases/%i/server
LoadCredentialEncrypted=database_url:/etc/credstore.encrypted/PRODUCTO/migrate_database_url
LoadCredentialEncrypted=min_client_versions:/etc/credstore.encrypted/PRODUCTO/min_client_versions
LoadCredentialEncrypted=page_token_key:/etc/credstore.encrypted/PRODUCTO/page_token_key
ExecStart=/srv/PRODUCTO/releases/%i/server/.venv/bin/alembic upgrade head
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
RemoveIPC=yes
UMask=0077
