[Unit]
Description=PRODUCTO example data of %i
After=postgresql.service

[Service]
Type=oneshot
# The example data are rows and files like the ones the app writes: they go in as the server,
# with its folder of files, which the owner of the schema cannot write (ADR-0157).
User=PRODUCTO
Group=PRODUCTO
WorkingDirectory=/srv/PRODUCTO/releases/%i/server
LoadCredentialEncrypted=app:/etc/credstore.encrypted/PRODUCTO
StateDirectory=PRODUCTO/files
# ADR-0128: only on a machine in development, which database.py checks.
ExecStart=/srv/PRODUCTO/releases/%i/server/.venv/bin/python -m app.tasks mock
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# ADR-0149: the OpenBLAS of numpy sets the memory policy of its threads with mbind, and a
# denied syscall kills the process.
SystemCallFilter=mbind
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
RemoveIPC=yes
UMask=0077
