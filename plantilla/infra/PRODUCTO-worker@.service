[Unit]
Description=PRODUCTO worker %i
After=network-online.target postgresql.service valkey-server@PRODUCTO.service
Wants=network-online.target

[Service]
Type=exec
User=PRODUCTO
Group=PRODUCTO
WorkingDirectory=/srv/PRODUCTO/current/server
LoadCredentialEncrypted=app:/etc/credstore.encrypted/PRODUCTO
StateDirectory=PRODUCTO/files
# ADR-0251: python -m app.tasks runs a task of WORKERS in rounds, and never ends on its own.
ExecStart=/srv/PRODUCTO/current/server/.venv/bin/python -m app.tasks %i
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# ADR-0149: the OpenBLAS of numpy sets the memory policy of its threads with mbind, and a
# denied syscall kills the process.
SystemCallFilter=mbind
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
RemoveIPC=yes
UMask=0077

[Install]
WantedBy=multi-user.target
