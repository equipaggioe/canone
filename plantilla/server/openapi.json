  "components": {
    "schemas": {
      "AssertionResponse": {
        "properties": {
          "clientDataJSON": {
            "type": "string",
            "title": "Clientdatajson"
          },
          "authenticatorData": {
            "type": "string",
            "title": "Authenticatordata"
          },
          "signature": {
            "type": "string",
            "title": "Signature"
          },
          "userHandle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Userhandle"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "clientDataJSON",
          "authenticatorData",
          "signature"
        ],
        "title": "AssertionResponse",
        "description": "What the authenticator signed, in base64url."
      },
      "CredentialDescriptor": {
        "properties": {
          "type": {
            "type": "string",
            "const": "public-key",
            "title": "Type"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "transports": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Transports"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "id",
          "transports"
        ],
        "title": "CredentialDescriptor",
        "description": "A passkey the ceremony may use, by its ID in base64url."
      },
      "EventLevel": {
        "type": "string",
        "enum": [
          "info",
          "warn",
          "critical"
        ],
        "title": "EventLevel",
        "description": "The level that the OWASP vocabulary gives each event."
      },
      "HealthEvents": {
        "properties": {
          "lastEventAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lasteventat"
          },
          "lastCriticalAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lastcriticalat"
          },
          "lastBackupAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lastbackupat"
          },
          "diskFreeBytes": {
            "type": "integer",
            "title": "Diskfreebytes"
          },
          "diskTotalBytes": {
            "type": "integer",
            "title": "Disktotalbytes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lastEventAt",
          "lastCriticalAt",
          "lastBackupAt",
          "diskFreeBytes",
          "diskTotalBytes"
        ],
        "title": "HealthEvents",
        "description": "The last events, the last good backup and the disk."
      },
      "LoggedEvent": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "title": "Occurredat"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "level": {
            "$ref": "#/components/schemas/EventLevel"
          },
          "actorId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actorid"
          },
          "actorLabel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actorlabel"
          },
          "targetType": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Targettype"
          },
          "targetId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Targetid"
          },
          "ipAddress": {
            "anyOf": [
              {
                "type": "string",
                "format": "ipv4"
              },
              {
                "type": "string",
                "format": "ipv6"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ipaddress"
          },
          "userAgent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Useragent"
          },
          "traceId": {
            "type": "string",
            "title": "Traceid"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "occurredAt",
          "action",
          "level",
          "actorId",
          "actorLabel",
          "targetType",
          "targetId",
          "ipAddress",
          "userAgent",
          "traceId",
          "details"
        ],
        "title": "LoggedEvent",
        "description": "One row of event_log, as the server wrote it."
      },
      "Page_LoggedEvent_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/LoggedEvent"
            },
            "type": "array",
            "title": "Items"
          },
          "nextPageToken": {
            "type": "string",
            "title": "Nextpagetoken"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "nextPageToken"
        ],
        "title": "Page[LoggedEvent]"
      },
      "PasskeyCredential": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "rawId": {
            "type": "string",
            "title": "Rawid"
          },
          "type": {
            "type": "string",
            "const": "public-key",
            "title": "Type"
          },
          "response": {
            "$ref": "#/components/schemas/AssertionResponse"
          },
          "clientExtensionResults": {
            "additionalProperties": true,
            "type": "object",
