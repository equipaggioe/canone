            "type": "array",
            "title": "Allowcredentials"
          },
          "userVerification": {
            "type": "string",
            "const": "preferred",
            "title": "Userverification"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "challenge",
          "rpId",
          "allowCredentials",
          "userVerification"
