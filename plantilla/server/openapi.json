          },
          "authenticatorAttachment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Authenticatorattachment"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "rawId",
          "type",
          "response",
          "clientExtensionResults"
        ],
        "title": "PasskeyCredential",
        "description": "The whole response of navigator.credentials.get()."
      },
      "PasskeyOptions": {
        "properties": {
          "challenge": {
            "type": "string",
            "title": "Challenge"
          },
          "rpId": {
            "type": "string",
            "title": "Rpid"
          },
          "allowCredentials": {
            "items": {
              "$ref": "#/components/schemas/CredentialDescriptor"
