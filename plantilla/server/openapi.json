{
  "openapi": "3.1.0",
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Check",
        "description": "Answer 503 when the database does not.",
        "operationId": "healthCheck",
        "parameters": [
          {
            "name": "user-agent",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "User-Agent"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health/events": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Events",
        "description": "Tell the last events, the last backup and the disk.",
        "operationId": "healthEvents",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "user-agent",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "User-Agent"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthEvents"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health/event-log": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Event Log",
        "description": "Page event_log up to the oldest open transaction.",
        "operationId": "healthEventLog",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 50,
              "title": "Pagesize"
            }
          },
          {
            "name": "pageToken",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Pagetoken"
            }
          },
          {
            "name": "user-agent",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "User-Agent"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_LoggedEvent_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EventLevel": {
        "type": "string",
        "enum": [
          "info",
          "warn",
          "critical"
        ],
        "title": "EventLevel",
        "description": "The level that the OWASP vocabulary gives each event."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthEvents": {
        "properties": {
          "lastEventAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lasteventat"
          },
          "lastCriticalAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lastcriticalat"
          },
          "lastBackupAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lastbackupat"
          },
          "diskFreeBytes": {
            "type": "integer",
            "title": "Diskfreebytes"
          },
          "diskTotalBytes": {
            "type": "integer",
            "title": "Disktotalbytes"
          }
        },
        "type": "object",
        "required": [
          "lastEventAt",
          "lastCriticalAt",
          "lastBackupAt",
          "diskFreeBytes",
          "diskTotalBytes"
        ],
        "title": "HealthEvents",
        "description": "The last events, the last good backup and the disk."
      },
      "LoggedEvent": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "title": "Occurredat"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "level": {
            "$ref": "#/components/schemas/EventLevel"
          },
          "actorId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actorid"
          },
          "actorLabel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actorlabel"
          },
          "targetType": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Targettype"
          },
          "targetId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Targetid"
          },
          "ipAddress": {
            "anyOf": [
              {
                "type": "string",
                "format": "ipv4"
              },
              {
                "type": "string",
                "format": "ipv6"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ipaddress"
          },
          "userAgent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Useragent"
          },
          "traceId": {
            "type": "string",
            "title": "Traceid"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "id",
          "occurredAt",
          "action",
          "level",
          "actorId",
          "actorLabel",
          "targetType",
          "targetId",
          "ipAddress",
          "userAgent",
          "traceId",
          "details"
        ],
        "title": "LoggedEvent",
        "description": "One row of event_log, as the server wrote it."
      },
      "Page_LoggedEvent_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/LoggedEvent"
            },
            "type": "array",
            "title": "Items"
          },
          "nextPageToken": {
            "type": "string",
            "title": "Nextpagetoken"
          }
        },
        "type": "object",
        "required": [
          "items",
          "nextPageToken"
        ],
        "title": "Page[LoggedEvent]"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
